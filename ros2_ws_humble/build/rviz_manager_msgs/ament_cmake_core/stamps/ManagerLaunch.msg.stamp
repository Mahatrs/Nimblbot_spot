std_msgs/Header header

int32 id                  # unique identifier
string action             # "start", "stop", "restart", "status"

string ns

bool bash_session          # true = session ros, false = custom cmd
bool is_launch_file       # true = launch file, false = node
string package
string executable         # node or launch file

string[] arguments        # CLI args
string[] ros_arguments    # --ros-args ...

string working_dir        # optional
string session_name       # tmux session name (optional override)

bool use_sim_time         # optional flag

int32 timeout             # optional (sec)