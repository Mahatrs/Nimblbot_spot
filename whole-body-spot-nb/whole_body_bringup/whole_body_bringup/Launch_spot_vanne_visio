source /opt/ros/humble/setup.zsh
source {SPOT_WS}/install/setup.zsh

rm -f "{VALVE_JSON_OUT}"

ros2 run spot_examples relative_move_then_pose_avec_camera \\
    --model "{VALVE_MODEL_PATH}" \\
    --valve-class handwheel \\
    --dx {xtarget} \\
    --dy {ytarget} \\
    --dz {ztarget} \\
    --dyaw 0.0 \\
    --roll 0.0 \\
    --pitch 0.0 \\
    --yaw 0.0 \\
    --frame {frame} \\
    --output "{VALVE_OUTPUT_DIR}" \\
    --output-json "{VALVE_JSON_OUT}" \\
    --no-display

CAMERA_EXIT_CODE=$?

if [ "$CAMERA_EXIT_CODE" -ne 0 ]; then
    echo "ERREUR : relative_pose_then_move_avec_camera a échoué."
    echo "Code de sortie : $CAMERA_EXIT_CODE"
    exit 1
fi

if [ ! -f "{VALVE_JSON_OUT}" ]; then
    echo "ERREUR : fichier de position de vanne introuvable."
    echo "Fichier attendu : {VALVE_JSON_OUT}"
    exit 1
fi

XVANNE3D=$(python3 -c 'import json; print(json.load(open("{VALVE_JSON_OUT}"))["x"])')
YVANNE3D=$(python3 -c 'import json; print(json.load(open("{VALVE_JSON_OUT}"))["y"])')
ZVANNE3D=$(python3 -c 'import json; print(json.load(open("{VALVE_JSON_OUT}"))["z"])')
