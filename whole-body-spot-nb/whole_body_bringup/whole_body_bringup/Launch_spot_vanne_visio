    --Zbase "$ARM_Z" \\
    --Xtarget "$XVANNE3D" \\
    --Ytarget "$YVANNE3D" \\
    --Ztarget "$ZVANNE3D" \\
    --roll 0.0 \\
    --pitch 0.0 \\
    --yaw 0.0

sleep 1
"""

def main():
